@model List<Web_IB.Entities.Competence>
@using Web_IB.shared

<h2 class="mb-3">Manage Skills</h2>

<a class="btn btn-link mb-3" asp-controller="Portfolio" asp-action="Index">
    ← Back to My Portfolio
</a>

<!-- ADD SKILL -->
<div class="card mb-3">
    <div class="card-header"><strong>Add skill</strong></div>
    <div class="card-body">
        <form asp-controller="Skills" asp-action="Create" method="post" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label">Skill name</label>
                <input name="nom" class="form-control" placeholder="Ex: C#, SQL, HTML" />
            </div>

            <div class="col-md-5">
                <label class="form-label">Level</label>
                <select name="niveau" class="form-select">
                    <option value="">-- Select level --</option>
                    @foreach (var n in Enum.GetValues(typeof(NiveauCompetence)))
                    {
                        <option value="@n">@n</option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">Add</button>
            </div>
        </form>
    </div>
</div>

<!-- LIST + UPDATE / DELETE -->
<div class="card">
    <div class="card-header"><strong>Your skills</strong></div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-muted">No skills yet.</div>
        }
        else
        {
            @foreach (var s in Model)
            {
                <div class="border rounded p-2 mb-2">
                    <div class="row g-2 align-items-end">

                        <!-- UPDATE -->
                        <form asp-controller="Skills" asp-action="Update" method="post" class="col-md-10 row g-2">
                            <input type="hidden" name="id" value="@s.Id" />

                            <div class="col-md-5">
                                <label class="form-label">Skill</label>
                                <input class="form-control" name="nom" value="@s.Nom" />
                            </div>

                            <div class="col-md-5">
                                <label class="form-label">Level</label>
                                <select name="niveau" class="form-select">
                                    <option value="">-- None --</option>
                                    @foreach (var n in Enum.GetValues(typeof(NiveauCompetence)))
                                    {
                                        <option value="@n" selected="@(s.Niveau == (NiveauCompetence)n)">
                                            @n
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-2 d-flex gap-2">
                                <button class="btn btn-outline-success w-100" type="submit">Save</button>
                            </div>
                        </form>

                        <!-- DELETE -->
                        <form asp-controller="Skills" asp-action="Delete" method="post" class="col-md-2">
                            <input type="hidden" name="id" value="@s.Id" />
                            <button class="btn btn-outline-danger w-100" type="submit">Delete</button>
                        </form>

                    </div>
                </div>
            }
        }
    </div>
</div>
