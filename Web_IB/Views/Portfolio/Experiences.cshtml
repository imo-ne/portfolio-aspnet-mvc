@model List<Web_IB.Entities.Experience>

<h2 class="mb-3">Manage Experience</h2>
<a class="btn btn-link mb-3" asp-controller="Portfolio" asp-action="Index">← Back to My Portfolio</a>

<div class="card mb-3">
    <div class="card-header"><strong>Add experience</strong></div>
    <div class="card-body">
        <form asp-controller="Experiences" asp-action="Create" method="post" class="row g-2">
            <div class="col-md-3">
                <input name="poste" class="form-control" placeholder="Poste (ex: Stagiaire Dev)" />
            </div>
            <div class="col-md-3">
                <input name="entreprise" class="form-control" placeholder="Entreprise" />
            </div>
            <div class="col-md-2">
                <input name="dateDebut" type="date" class="form-control" />
            </div>
            <div class="col-md-2">
                <input name="dateFin" type="date" class="form-control" />
            </div>
            <div class="col-md-2">
                <input name="description" class="form-control" placeholder="Description (optional)" />
            </div>

            <div class="col-12">
                <button class="btn btn-primary" type="submit">Add</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header"><strong>Your experiences</strong></div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="text-muted">No experiences yet.</div>
        }
        else
        {
            @foreach (var e in Model)
            {
                <div class="border rounded p-2 mb-2">
                    <div class="row g-2 align-items-end">

                        <!-- UPDATE FORM (alone) -->
                        <form asp-controller="Experiences" asp-action="Update" method="post" class="col-md-10 row g-2">
                            <input type="hidden" name="id" value="@e.Id" />

                            <div class="col-md-3">
                                <label class="form-label">Poste</label>
                                <input class="form-control" name="poste" value="@e.Poste" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Entreprise</label>
                                <input class="form-control" name="entreprise" value="@e.Entreprise" />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Date début</label>
                                <input class="form-control" type="date" name="dateDebut" value="@(e.DateDebut?.ToString("yyyy-MM-dd"))" />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Date fin</label>
                                <input class="form-control" type="date" name="dateFin" value="@(e.DateFin?.ToString("yyyy-MM-dd"))" />
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Description</label>
                                <input class="form-control" name="description" value="@e.Description" />
                            </div>

                            <div class="col-12">
                                <button class="btn btn-outline-success" type="submit">Save</button>
                            </div>
                        </form>

                        <!-- DELETE FORM (separate) -->
                        <form asp-controller="Experiences" asp-action="Delete" method="post" class="col-md-2">
                            <input type="hidden" name="id" value="@e.Id" />
                            <button class="btn btn-outline-danger w-100" type="submit">Delete</button>
                        </form>

                    </div>
                </div>
            }
        }
    </div>
</div>
