@model Web_IB.Models.LoginViewModel

<h2>Login</h2>

<form asp-controller="Account" asp-action="Login" method="post" class="mt-3">
    <div class="mb-2">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Mot de passe</label>
        <input asp-for="MotDePasse" class="form-control" />
        <span asp-validation-for="MotDePasse" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Se connecter</button>

    <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
